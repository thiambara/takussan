# ==========================================
# API
# URL du backend Laravel (doit matcher APP_URL côté takussan-api)
# ==========================================
NEXT_PUBLIC_API_URL=http://127.0.0.1:8002

# ==========================================
# SITE PUBLIC
# Origine publique du front — elle porte les `hreflang` (ADR-0026), le `canonical` et toutes les
# URL de `/sitemap.xml` et de `/robots.txt`.
#
# LAISSER VIDE en local et en production : le défaut est l'origine MESURÉE de la production,
# https://www.takussan.com (docs/infra/frontend-deploiement.json). Sur une prévisualisation
# Vercel, l'hôte du déploiement est déduit de VERCEL_URL — cf. `resoudreOrigineSite`
# (src/lib/alternates.ts). Ne la renseigner que pour servir le site sur une AUTRE origine.
#
# ⚠ La valeur attendue est une ORIGINE, pas une URL : schéma + hôte, sans chemin ni barre finale.
#   Toute autre forme fait échouer la génération en nommant cette clé.
# ==========================================
NEXT_PUBLIC_SITE_URL=

# ==========================================
# MÉDIAS (ADR-0029 §4, TCK-540)
# Origine du seau public R2, servie par Cloudflare Transformations — ex. https://media-preview.takussan.com.
#
# LAISSER VIDE en local : les photos viennent de l'API (disque `public`) et passent par l'optimiseur
# de Next, comme avant. Renseignée, elle branche `src/lib/image-loader.ts` à la place de l'optimiseur
# (cf. le bloc `images` de next.config.ts) ; l'image Docker l'EXIGE.
#
# ⚠ Une ORIGINE, pas une URL : schéma + hôte, sans chemin ni barre finale. Toute autre forme fait
#   échouer la compilation en nommant cette clé.
# ==========================================
NEXT_PUBLIC_MEDIA_URL=

# ==========================================
# SERVEUR NEXT → API (ADR-0052 §5, TCK-598) — clés SERVEUR, lues à l'exécution, jamais inlinées
#
# API_INTERNAL_URL : l'API sur le réseau interne (preview : http://api:8080). LAISSER VIDE en local
#   et sur Vercel : le serveur appelle alors NEXT_PUBLIC_API_URL. Posée, le front envoie aussi
#   X-Forwarded-Host/Proto/Port dérivés de NEXT_PUBLIC_API_URL.
# VISITOR_IP_TRUSTED_HOPS : nombre de mandataires de confiance devant Next, qui ont chacun AJOUTÉ une
#   entrée à droite de X-Forwarded-For. Défaut 1 (Vercel) ; preview : 2 (Cloudflare puis Traefik).
#   L'IP transmise à l'API est l'entrée de rang n − h, jamais la plus à gauche.
# ==========================================
API_INTERNAL_URL=
VISITOR_IP_TRUSTED_HOPS=

# ==========================================
# CACHE DE LA FICHE PUBLIQUE (ADR-0052 §2, TCK-598)
# Secret partagé avec l'API (même valeur que PUBLIC_CACHE_REVALIDATE_SECRET côté takussan-api) :
# il signe POST /api/revalidation/fiche. VIDE, le handler refuse tout (401) et une fiche dépubliée
# reste servie jusqu'à la fin de sa fraîcheur (300 s).
# ==========================================
PUBLIC_CACHE_REVALIDATE_SECRET=
