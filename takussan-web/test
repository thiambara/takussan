Inventory: (id, team_id, name, is_active) // list des produit d'une pharmacie
InventoryItem: (id, inventory_id, status, qty, expiration_date, cost, prise) // quantite d'un produit groupe par date d'expiration, prix d'achat et prix de vente
Saisie: (id, team_id, created_at, status) // representation d'une commande (saisie)
SaisieItem: (id, saisie_id, inventory_id, quantity, expiration_date, cost, prise, inventory_item) // list des produits dans une saisie avec les informations associées
Sale: (id, team_id, created_at, status) // representation d'une vente
SaleItem: (id, sale_id, product_id, quantity, price) // list des produits dans une vente avec les informations associées. product_id est l'id de l'inventory
StockChange: (id, inventory_id, quantity, new_stock, type) // log des mouvements de stock des produits

