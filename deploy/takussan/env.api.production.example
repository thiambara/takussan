# Gabarit de l'onglet Environment du Compose `takussan-api-production` dans Dokploy (ADR-0028, ADR-0069 § 1).
# La préproduction porte les mêmes clés, en valeurs de préproduction. Mode d'emploi : docs/infra/hebergement.md.
#
# · Une ligne par clé qu'on pose. Les résidus n'y sont pas : scripts/check-env-production.mjs les nomme, avec leur motif.
# · Une valeur vide est un secret ou une intégration à remplir, jamais un défaut : une clé dont config/ a un défaut non
#   vide porte ce défaut écrit (`env('X', 'd')` rend '' sur une ligne vide). `null` est lu comme le null de PHP.
# · REDIS_HOST et REDIS_PORT n'y sont pas : compose.api.yml les écrit, et `environment` l'emporte sur `env_file`.
# · `# requise` : le service ne tient pas sans elle. `# intégration` : vide tant que le compte n'existe pas.
#   `# réglage` : le défaut convient. Les commentaires sont facultatifs dans l'onglet.

# ==========================================
# 1. Application
# ==========================================
# requise
IMAGE_TAG=production
API_ALIAS=takussan-api-production
APP_NAME=Takussan
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.takussan.com
# réglage
APP_PREVIOUS_KEYS=
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12
ACCOUNT_DELETION_GRACE_DAYS=30
ACCOUNT_DELETION_REMINDER_DAYS=7
PRIVACY_RIGHTS_REQUEST_DEADLINE_DAYS=30
VISITS_FEEDBACK_WINDOW_HOURS=24
ACTIVITYLOG_ENABLED=true
ACTIVITYLOG_BUFFER_ENABLED=false

# ==========================================
# 2. Front et Sanctum
# ==========================================
# requise
FRONTEND_URL=https://www.takussan.com
SANCTUM_STATEFUL_DOMAINS=www.takussan.com
# Le sous-réseau de dokploy-network, puis les plages publiées par Cloudflare (relues le 2026-11-01 ; plages-cloudflare.timer les compare chaque jour).
TRUSTED_PROXIES=10.0.1.0/24,173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32
PUBLIC_CACHE_REVALIDATE_URL=https://www.takussan.com/api/revalidation/fiche
PUBLIC_CACHE_REVALIDATE_SECRET=
# réglage
SANCTUM_TOKEN_PREFIX=

# ==========================================
# 3. Base de données
# ==========================================
# requise
DB_CONNECTION=pgsql
DB_HOST=serveur-postgres-egr6ii
DB_PORT=5432
DB_DATABASE=takussan_prod
DB_USERNAME=takussan_prod
DB_PASSWORD=
# réglage
DB_SSLMODE=prefer

# ==========================================
# 4. Sessions, cache, files et disques
# ==========================================
# requise
SESSION_DRIVER=redis
SESSION_DOMAIN=.takussan.com
SESSION_COOKIE=takussan_session
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
CACHE_PREFIX=takussan-production-cache-
QUEUE_CONNECTION=database
# réglage
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SESSION_PARTITIONED_COOKIE=false
SESSION_EXPIRE_ON_CLOSE=false
DB_QUEUE_RETRY_AFTER=90
DB_LONG_QUEUE_RETRY_AFTER=1900
QUEUE_FAILED_DRIVER=database-uuids
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ==========================================
# 5. Redis
# ==========================================
# requise
REDIS_CLIENT=phpredis
REDIS_PASSWORD=
# réglage
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=takussan-database-
REDIS_PERSISTENT=false

# ==========================================
# 6. Journaux
# ==========================================
# requise
LOG_CHANNEL=stderr
LOG_LEVEL=info
# réglage
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false

# ==========================================
# 7. Recherche
# ==========================================
# requise
SCOUT_DRIVER=meilisearch
SCOUT_PREFIX=prod_
SCOUT_QUEUE=true
SCOUT_AFTER_COMMIT=true
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=
# réglage
SCOUT_IDENTIFY=false

# ==========================================
# 8. Courriel
# ==========================================
# requise
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=contact@takussan.com
MAIL_FROM_NAME=Takussan
RESEND_API_KEY=
# réglage
RESEND_BASE_URL=api.resend.com
MAIL_LOG_CHANNEL=null

# ==========================================
# 9. Médias et R2
# ==========================================
# requise
MEDIA_PUBLIC_DISK=r2-media
MEDIA_PRIVATE_DISK=r2-private
MEDIA_QUEUE=media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_MEDIA_BUCKET=takussan-prod-media
R2_MEDIA_URL=https://media.takussan.com
R2_PRIVATE_BUCKET=takussan-prod-private
# réglage
MEDIA_PREFIX=
MEDIA_DOWNLOADER_SSL=true
MEDIA_TEMPORARY_URL_DEFAULT_LIFETIME=5
QUEUE_CONVERSIONS_BY_DEFAULT=true
QUEUE_CONVERSIONS_AFTER_DB_COMMIT=true
FORCE_MEDIA_LIBRARY_LAZY_LOADING=true
IMAGE_DRIVER=gd
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
FFMPEG_TIMEOUT=900
FFMPEG_THREADS=0

# ==========================================
# 10. IA
# ==========================================
# intégration
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
VOYAGE_API_KEY=
VOYAGE_TRAINING_OPT_OUT=false
# réglage
ANTHROPIC_URL=
OPENAI_URL=
OPENROUTER_URL=
VOYAGE_URL=
AI_DAILY_BUDGET_USD=8.33
AI_USD_TO_XOF=600
AI_TIMEOUT_SECONDS=300

# ==========================================
# 11. Radar
# ==========================================
# requise
RADAR_PHONE_HMAC_KEY=
# intégration
RADAR_WHATSAPP_PHONE_NUMBER_ID=
RADAR_WHATSAPP_ACCESS_TOKEN=
RADAR_WHATSAPP_WEBHOOK_URL_TOKEN=
RADAR_WHATSAPP_WEBHOOK_APP_SECRET=
RADAR_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# En dernier, une fois le numéro et l'application Meta du Radar en place : `cloud`.
RADAR_WHATSAPP_DRIVER=log
# réglage
RADAR_PHONE_HMAC_PREVIOUS_KEYS=
RADAR_WHATSAPP_AUTO_STOP=true
RADAR_MERGE_AUTO=false
RADAR_SIMILARITY_DRIVER=
RADAR_NATURE_COUNTS=false

# ==========================================
# 12. Connexion par téléphone et SMS
# ==========================================
# requise
PHONE_LOGIN_ENABLED=true
OTP_PREVIEW_ENABLED=false
SMS_DEFAULT_DRIVER=router
SMS_LOG_FALLBACK=false
# Vides en `production`, ces listes refusent tous les accusés en 403 : les plages se demandent à chaque fournisseur.
SMS_ORANGE_WEBHOOK_IPS=
SMS_MTARGET_WEBHOOK_IPS=
SMS_LAM_WEBHOOK_IPS=
# intégration
SMS_WEBHOOK_URL_TOKEN=
SMS_ORANGE_WEBHOOK_URL_TOKEN=
SMS_MTARGET_WEBHOOK_URL_TOKEN=
SMS_LAM_WEBHOOK_URL_TOKEN=
SMS_DLR_PULL_DRIVER=log
SMS_DLR_PULL_ENABLED=false
SMS_MTARGET_PULL_URL=null
# réglage
SMS_RATE_LIMIT_PER_USER_HOUR=5
SMS_QUIET_HOURS_ENABLED=true
SMS_OTP_ALLOWED_COUNTRY_CODES=221
SMS_OTP_DAILY_CAP=2000
SMS_INVITATION_DAILY_CAP_PER_AGENCY=50
SMS_LAM_DLR_SIGNATURE_TTL_DAYS=7
SMS_ORANGE_OAUTH_URL=https://api.orange.com/oauth/v3/token
SMS_ORANGE_SEND_URL=https://api.orange.com/smsmessaging/v1/outbound/{senderAddress}/requests
SMS_MTARGET_SEND_URL=https://api-public-2.mtarget.fr/messages
SMS_LAM_SEND_URL=https://lampush-tls.lafricamobile.com/api/Send
SMS_DLR_PULL_MAX=50
SMS_DLR_PULL_MAX_BATCHES=20
SMS_MTARGET_WEBHOOK_ENABLED=true

# ==========================================
# 13. WhatsApp
# ==========================================
# intégration
WHATSAPP_WEBHOOK_URL_TOKEN=
WHATSAPP_WEBHOOK_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# réglage
WHATSAPP_DEFAULT_DRIVER=cloud
WHATSAPP_BASE_URI=https://graph.facebook.com/v21.0
WHATSAPP_RATE_LIMIT_PER_USER_HOUR=10
SEARCH_ALERTS_WHATSAPP_ENABLED=false

# ==========================================
# 14. Paiement
# ==========================================
# intégration
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_SIGNING_SECRET=
LEMON_SQUEEZY_STORE=
# réglage
ORANGE_MONEY_OAUTH_URL=https://api.orange.com/oauth/v3/token
LEMON_SQUEEZY_PATH=lemon-squeezy
LEMON_SQUEEZY_CURRENCY_LOCALE=en

# ==========================================
# 15. Connexion sociale
# ==========================================
# intégration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.takussan.com/auth/oauth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=https://www.takussan.com/auth/oauth/facebook/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_REDIRECT_URI=https://www.takussan.com/auth/oauth/apple/callback

# ==========================================
# 16. CDN
# ==========================================
# intégration
CDN_BASE_URL=
CDN_PULL_ZONE=
CDN_SIGNING_KEY=
BUNNY_ACCESS_KEY=
BUNNY_STORAGE_ZONE=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# réglage
CDN_ENABLED=false
CDN_PROVIDER=bunny
CDN_SIGNATURE_TTL=300
CDN_HEALTH_THRESHOLD=5
CDN_HEALTH_WINDOW=60
CDN_HEALTH_COOLDOWN=300

# ==========================================
# 17. PDF
# ==========================================
# requise
LARAVEL_PDF_DRIVER=dompdf

# ==========================================
# 18. Seed
# ==========================================
# réglage
# Sans effet en production : docker/seed.sh refuse toute base qui n'est ni *_preview ni *_smoke.
SEED_DOWNLOAD_MEDIA=false
SEED_AGENCIES=3
SEED_PROPERTIES_PER_AGENCY=150
SEED_CUSTOMERS_PER_AGENCY=120
SEED_BOOKINGS_PER_AGENCY=100
SEED_LEASES_PER_AGENCY=90
SEED_MAINTENANCE_PER_AGENCY=50
SEED_CONVERSATIONS_PER_AGENCY=60
SEED_DOCUMENTS_PER_AGENCY=40
SEED_EDGE_CASES=false
SEED_REFERENTIAL_INTEGRITY=true
SEED_FILTER_COVERAGE=false
SEED_DEMO_USERS=true
SEED_RANDOM_SEED=2026
SEED_SIGNED_CONTRACTS=true
