# ==========================================
# App
# ==========================================
APP_NAME=Takussan
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8002

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ==========================================
# Frontend & Sanctum
# ==========================================
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Comma-separated list of upstream proxy IPs/CIDRs that may set
# X-Forwarded-For (Next.js server-actions, load balancer, reverse proxy).
# Required so per-visitor rate limiters and `Request::ip()` see the real
# client IP instead of a single shared proxy address. In production, pin
# this to the actual proxy network — `*` allows IP spoofing.
TRUSTED_PROXIES=127.0.0.1,::1

# ==========================================
# Database
# ==========================================
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ==========================================
# Seeding (database/seeders/Support/SeedingConfig.php)
#
# Les VALEURS PAR DÉFAUT vivent dans `SeedingConfig::fromEnv()`, et nulle part
# ailleurs : ces clés sont déclarées vides parce que recopier ici les nombres
# du code en ferait une seconde source de vérité qui dérive au premier
# ajustement. Ce fichier est le contrat des CLÉS — il dit ce que
# l'application sait lire, pas ce qu'elle vaut par défaut.
#
# Les douze `SEED_*` ci-dessous ont manqué à ce contrat pendant que
# `SEED_DOWNLOAD_MEDIA` y figurait seul : le bloc avait l'air couvert. Comme
# `check-env-parity.mjs` compare ce fichier à `.env.docker` et jamais aux
# `env()` du code, une clé oubliée des DEUX côtés passe sans bruit.
# ==========================================
SEED_DOWNLOAD_MEDIA=true
# SEED_AGENCIES=
# SEED_PROPERTIES_PER_AGENCY=
# SEED_CUSTOMERS_PER_AGENCY=
# SEED_BOOKINGS_PER_AGENCY=
# SEED_LEASES_PER_AGENCY=
# SEED_MAINTENANCE_PER_AGENCY=
# SEED_CONVERSATIONS_PER_AGENCY=
# SEED_DOCUMENTS_PER_AGENCY=
# SEED_EDGE_CASES=
# SEED_REFERENTIAL_INTEGRITY=
# SEED_FILTER_COVERAGE=
# SEED_DEMO_USERS=

# ==========================================
# Session / Cache / Queue
# ==========================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
# CACHE_PREFIX=

QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==========================================
# Logging
# ==========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==========================================
# Search (Laravel Scout)
# Driver: collection (DB, defaut CI/local sans infra) | meilisearch | algolia | typesense
# Pour Meilisearch en local: SCOUT_DRIVER=meilisearch + lancer une instance
# (brew install meilisearch && brew services start meilisearch) + renseigner host/key.
# ==========================================
SCOUT_DRIVER=collection
# MEILISEARCH_HOST=http://localhost:7700
# MEILISEARCH_KEY=
# SCOUT_QUEUE=true          # recommande avec Meilisearch : indexation via worker (queue)
# SCOUT_AFTER_COMMIT=true   # n'indexe qu'apres commit de transaction (evite les rollback)
# SCOUT_PREFIX=

# ==========================================
# Mail
# ==========================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# AWS / S3 (used by filesystem + media-library when FILESYSTEM_DISK=s3)
# ==========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==========================================
# Vite
# ==========================================
VITE_APP_NAME="${APP_NAME}"

# ==========================================
# OAuth — Google
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${FRONTEND_URL}/auth/oauth/google/callback"

# ==========================================
# OAuth — Facebook
# ==========================================
# Leave these blank in local/dev if no real Facebook app is configured; the
# frontend hides unconfigured providers.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${FRONTEND_URL}/auth/oauth/facebook/callback"

# ==========================================
# OAuth — Apple (TCK-081)
# ==========================================
# Leave these blank in local/dev if no real Apple Services ID is configured;
# the frontend hides unconfigured providers.
# Services ID declared in Apple Developer → Identifiers (e.g. com.takussan.web).
APPLE_CLIENT_ID=
# Apple Developer Team ID (10-char), visible top-right of developer portal.
APPLE_TEAM_ID=
# Key ID (10-char) of the .p8 generated in Apple Developer → Keys.
APPLE_KEY_ID=
# Absolute path to the AuthKey_XXXXXXXXXX.p8 file. Leave empty outside prod.
APPLE_PRIVATE_KEY_PATH=
APPLE_REDIRECT_URI="${FRONTEND_URL}/auth/oauth/apple/callback"

# ==========================================
# CDN (TCK-105)
# Set CDN_ENABLED=true once the CDN is provisioned.
# ==========================================
CDN_ENABLED=false
CDN_PROVIDER=bunny
CDN_BASE_URL=
CDN_PULL_ZONE=
CDN_SIGNING_KEY=
CDN_SIGNATURE_TTL=300

BUNNY_ACCESS_KEY=
BUNNY_STORAGE_ZONE=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ==========================================
# Spatie Laravel PDF
# Driver: cloudflare | browsershot | gotenberg | dompdf
# ==========================================
LARAVEL_PDF_DRIVER=cloudflare

# ==========================================
# SMS — accusés de livraison entrants (TCK-102)
#
# Les 11 clés lues par `config/sms.php` n'étaient déclarées NULLE PART — ni ici, ni
# dans `.env.docker` (mesuré le 2026-08-16). La garde `check-env-parity.mjs` ne
# pouvait pas le voir : elle compare les deux fichiers entre eux, et une clé absente
# des DEUX est en parité parfaite. Une garde qui compare deux sources ne vérifie
# jamais qu'elles couvrent la troisième — le code.
# ==========================================
SMS_DEFAULT_DRIVER=log
SMS_RATE_LIMIT_PER_USER_HOUR=10
SMS_QUIET_HOURS_ENABLED=true

# Secret porté par l'URL du webhook, à faire tourner en cas de compromission.
# Les tableaux de bord des opérateurs doivent être mis à jour au même moment.
SMS_WEBHOOK_URL_TOKEN=

# ⚠️ LISTES BLANCHES D'IP — la SEULE protection disponible sur ces deux opérateurs.
#
# Ni l'API SMS d'Orange ni celle de Mtarget n'émettent de signature cryptographique
# (vérifié auprès des opérateurs, 2026-08-16 — cf. ardoise D-31). Orange fournit une
# adresse IP officielle à mettre en liste blanche et exige un point de terminaison
# HTTPS sur le port 443 avec un certificat valide (les auto-signés sont rejetés).
#
# ⚠️ FAIL-CLOSED EN PRODUCTION : `RestrictIpMiddleware` rend **403** quand la liste est
# vide et que `APP_ENV=production`. C'est le bon choix de sécurité, mais il a une
# conséquence opérationnelle qu'il faut connaître — laisser ces clés vides en
# production ne « désactive » pas le filtre : cela REFUSE tous les accusés de
# livraison, en silence, et les statuts d'envoi ne remontent jamais.
#
# Elles restent vides ici et dans `.env.docker` : hors production le middleware laisse
# passer, et aucune valeur réelle d'opérateur n'a sa place dans un fichier suivi par git.
SMS_ORANGE_WEBHOOK_IPS=
SMS_MTARGET_WEBHOOK_IPS=
SMS_LAM_WEBHOOK_IPS=

# Points d'entrée des opérateurs. Vides = valeurs par défaut de `config/sms.php`.
SMS_ORANGE_OAUTH_URL=
SMS_ORANGE_SEND_URL=
SMS_MTARGET_SEND_URL=
SMS_LAM_SEND_URL=

# ==========================================
# WhatsApp — gardes du webhook entrant (TCK-296)
# ==========================================
# Les trois clés ci-dessous sont lues par `config/whatsapp.php` avec un défaut à la
# chaîne VIDE, et chacune garde le webhook en ÉCHOUANT FERMÉ : jeton vide → 404,
# secret vide → rejet de signature, allowlist vide → 403.
#
# Elles n'étaient déclarées NULLE PART — ni ici, ni dans `.env.docker`. Le contrat
# des clés ignorait donc l'existence même du webhook WhatsApp, et le seul symptôme
# d'un déploiement sans elles aurait été un canal silencieux : aucune erreur, aucune
# alerte, aucun accusé de livraison.
#
# `scripts/check-webhook-env-keys.mjs` garde désormais cette couverture. Il DÉRIVE
# la liste des clés de `config/sms.php` et `config/whatsapp.php` à chaque exécution —
# une clé ajoutée demain est gardée sans que personne ne pense à la garde.
#
# ⚠️ Elles restent VIDES ici : `.env.example` est l'environnement de test de la CI
# (dette D-54), et une valeur non vide y armerait les gardes pour toute la suite.
WHATSAPP_WEBHOOK_URL_TOKEN=
WHATSAPP_WEBHOOK_APP_SECRET=
WHATSAPP_WEBHOOK_IPS=
# TCK-294 — Accusés de livraison Mtarget : tirés par nous, plus poussés par l'opérateur.
#
# Mtarget n'émet aucune signature (ardoise D-49) et recommande lui-même son API
# Pulling DLR/MO : notre serveur appelle l'opérateur avec les identifiants du compte,
# et il n'y a plus rien d'entrant à authentifier. La lecture est DESTRUCTIVE côté
# Mtarget — un appel réussi vide la file qu'il retourne — donc l'idempotence tient
# sur l'écriture (mise à jour d'une tentative existante, jamais d'insertion), pas sur
# une fenêtre rejouable.
#
# `log` est le driver par défaut : une copie fraîche du dépôt n'appelle jamais
# l'opérateur. Passer à `mtarget` ET mettre ENABLED à true pour activer réellement.
SMS_DLR_PULL_DRIVER=log
SMS_DLR_PULL_ENABLED=false
SMS_DLR_PULL_MAX=50
SMS_DLR_PULL_MAX_BATCHES=20
SMS_MTARGET_PULL_URL=

# Interrupteur du webhook Mtarget entrant (TCK-294). Il reste à `true` pendant la
# période de recouvrement : tant que le pulling n'a pas prouvé qu'il remonte les
# mêmes statuts, les deux voies coexistent. Le retrait est ce basculement à `false`
# — pas un déploiement — et il se défait aussi vite.
SMS_MTARGET_WEBHOOK_ENABLED=true
