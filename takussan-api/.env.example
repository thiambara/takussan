# ==========================================
# App
# ==========================================
APP_NAME=Takussan
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8002

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ==========================================
# Frontend & Sanctum
# ==========================================
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# ==========================================
# Database
# ==========================================
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SEED_DOWNLOAD_MEDIA=true

# ==========================================
# Session / Cache / Queue
# ==========================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# CACHE_PREFIX=

QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==========================================
# Logging
# ==========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==========================================
# Search (Laravel Scout)
# ==========================================
SCOUT_DRIVER=collection
# MEILISEARCH_HOST=http://localhost:7700
# MEILISEARCH_KEY=

# ==========================================
# Mail
# ==========================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# AWS / S3 (used by filesystem + media-library when FILESYSTEM_DISK=s3)
# ==========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==========================================
# Vite
# ==========================================
VITE_APP_NAME="${APP_NAME}"

# ==========================================
# OAuth — Google
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${FRONTEND_URL}/auth/oauth/google/callback"

# ==========================================
# OAuth — Facebook
# ==========================================
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${FRONTEND_URL}/auth/oauth/facebook/callback"

# ==========================================
# OAuth — Apple (TCK-081)
# ==========================================
# Services ID declared in Apple Developer → Identifiers (e.g. com.takussan.web).
APPLE_CLIENT_ID=
# Apple Developer Team ID (10-char), visible top-right of developer portal.
APPLE_TEAM_ID=
# Key ID (10-char) of the .p8 generated in Apple Developer → Keys.
APPLE_KEY_ID=
# Absolute path to the AuthKey_XXXXXXXXXX.p8 file. Leave empty outside prod.
APPLE_PRIVATE_KEY_PATH=
APPLE_REDIRECT_URI="${FRONTEND_URL}/auth/oauth/apple/callback"

# ==========================================
# Spatie Laravel PDF
# Driver: cloudflare | browsershot | gotenberg | dompdf
# ==========================================
LARAVEL_PDF_DRIVER=cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
