# ==========================================
# Environnement de développement SUR DOCKER — `docker-compose.yml` à la racine.
#
#   ./dev.sh          copie ce fichier vers `.env` s'il n'existe pas, puis démarre tout.
#   cp .env.docker .env && php artisan key:generate    (à la main, si on préfère)
#
# Ce fichier existe parce que `.env.example` décrit un environnement qui n'est celui
# de PERSONNE : il pose `SCOUT_DRIVER=collection` quand la CI et la production indexent
# sur Meilisearch, et `CACHE_STORE=redis` sans que LUI-MÊME fournisse Redis — un
# développeur qui suit ce seul fichier, hors docker, obtient une application qui ne
# démarre pas.
#
# ⚠ Ce paragraphe citait un TROISIÈME écart jusqu'au 2026-08-22 — « il pose
# `DB_CONNECTION=sqlite` quand la production tourne sur MySQL 8.0 ». Les deux moitiés
# sont fausses depuis ADR-0020 : `.env.example` pose `pgsql` comme ce fichier, et il n'y
# a plus qu'UN moteur, PostgreSQL 17, sur tous les environnements. L'écart a disparu ;
# la phrase, elle, était restée, trois lignes au-dessus de valeurs qui la démentaient.
#
# Ici, chaque driver est celui de la PRODUCTION, servi par un conteneur local. Ce
# n'est pas du confort : c'est la seule façon qu'une migration, une recherche ou une
# requête soit éprouvée avant le déploiement plutôt qu'après.
#
# ⚠️ `.env.example` reste le contrat des CLÉS. Les deux fichiers doivent déclarer
# exactement le même jeu de clés — `node scripts/check-env-parity.mjs` le vérifie, et
# la CI le rejoue. Une clé ajoutée d'un côté et pas de l'autre est un piège qui ne se
# révèle qu'au moment où quelqu'un reprend le projet.
# ==========================================

# ==========================================
# App
# ==========================================
APP_NAME=Takussan
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# `127.0.0.1` et non `localhost`, pour s'accorder avec ce que le reste du dispositif fait
# RÉELLEMENT : `dev.sh` lance `artisan serve --host=127.0.0.1`, et `takussan-web` pointe sur
# `http://127.0.0.1:8002`. Du point de vue du navigateur, `localhost` et `127.0.0.1` sont deux
# ORIGINES distinctes : tout ce qui repose sur un cookie same-origin, ou sur `APP_URL` pour
# construire une redirection de retour vers l'API, tombe sur la mauvaise. C'est sans effet tant
# que l'authentification passe par un Bearer via le BFF — mais `.env.docker` est le socle
# reproductible du projet, et il ne doit pas graver un désaccord dans son défaut.
APP_URL=http://127.0.0.1:8002

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4
# 4 et non 12 : le hachage n'est pas ce qu'on éprouve en développement, et 12 rounds
# rendent chaque login de test ~250 ms. La production garde le défaut du framework.
BCRYPT_ROUNDS=4

# ==========================================
# Frontend & Sanctum
# ==========================================
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Comma-separated list of upstream proxy IPs/CIDRs that may set
# X-Forwarded-For (Next.js server-actions, load balancer, reverse proxy).
# Required so per-visitor rate limiters and `Request::ip()` see the real
# client IP instead of a single shared proxy address. In production, pin
# this to the actual proxy network — `*` allows IP spoofing.
TRUSTED_PROXIES=127.0.0.1,::1

# ==========================================
# Database — service `postgres` du compose (`pgvector/pgvector:pg17`)
#
# PostgreSQL 17 sur TOUS les environnements, suite de tests comprise (ADR-0020).
# SQLite et MySQL ont été RETIRÉS : ce ne sont plus des variantes supportées, et
# `./dev.sh doctor` avertit sur tout autre `DB_CONNECTION` — rien d'autre ne rougira.
#
# 5433 et non 5432 : le port canonique est laissé à une éventuelle installation brew
# de PostgreSQL, pour que les deux mondes cohabitent au lieu que l'un démonte l'autre.
# Si tu changes `TAKUSSAN_DB_PORT` dans le `.env` de la racine, change DB_PORT ici —
# `./dev.sh` le vérifie et refuse de démarrer sur un désaccord plutôt que de te laisser
# déboguer une connexion morte.
#
# ⚠ Le cas inverse ne rougit JAMAIS : viser 5432 fait répondre le PostgreSQL de brew,
# et rien de ce que `docker-compose.yml` garantit ne s'applique alors — ni la version
# 17, ni `--locale=C` (dont dépend le sens de six contraintes d'unicité sur texte), ni
# la disponibilité de pgvector. `./dev.sh doctor` nomme ce cas depuis TCK-301.
# ==========================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=takussan
DB_USERNAME=takussan
DB_PASSWORD=takussan

# Le seeder télécharge de vraies photos de biens depuis picsum.photos.
#
# `false`, et non `true` (TCK-301). C'est CE fichier que `./dev.sh` recopie en
# `takussan-api/.env` au premier démarrage : le `true` qui vivait ici décidait donc,
# pour tout nouveau développeur et sans lui demander, de 1000 à 2700 requêtes HTTP
# sortantes au premier `migrate:fresh --seed` — 15 s de timeout chacune, sur un jeu
# de données dont AUCUNE image n'est nécessaire pour naviguer l'interface.
#
# `true` reste un choix parfaitement valable — mais un choix, pas un défaut hérité.
# Les échecs de téléchargement sont désormais comptés et imprimés en fin de seeding,
# et `db:seed` sort en erreur au-delà de 10 % d'échecs (`YearOfActivitySeeder`) :
# un jeu de données partiel ne peut plus se faire passer pour complet.
SEED_DOWNLOAD_MEDIA=false

# Les volumes du seeder — lus par `SeedingConfig::fromEnv()`, qui porte les
# valeurs par défaut. Décommenter pour alléger un `migrate:fresh --seed` :
# `SEED_AGENCIES=1` + `SEED_PROPERTIES_PER_AGENCY=20` suffit pour naviguer
# l'interface sans attendre les ~450 biens du jeu complet.
# SEED_AGENCIES=
# SEED_PROPERTIES_PER_AGENCY=
# SEED_CUSTOMERS_PER_AGENCY=
# SEED_BOOKINGS_PER_AGENCY=
# SEED_LEASES_PER_AGENCY=
# SEED_MAINTENANCE_PER_AGENCY=
# SEED_CONVERSATIONS_PER_AGENCY=
# SEED_DOCUMENTS_PER_AGENCY=
# SEED_EDGE_CASES=
# SEED_REFERENTIAL_INTEGRITY=
# SEED_FILTER_COVERAGE=
# SEED_DEMO_USERS=

# ==========================================
# Session / Cache / Queue
#
# ⚠ CE BLOC DISAIT L'INVERSE, ET IL ÉTAIT FAUX SUR LES TROIS PLANS — corrigé le 2026-08-22.
#
# Il affirmait « `database` partout, comme la PRODUCTION (cf. docs/infra/deploy-preview.html) —
# et non `redis`, que `.env.example` propose sans que la production l'utilise ».
#
# 1. La production déclare `redis`, et c'est MESURÉ. `docs/infra/prod-drivers.json` — le relevé
#    qui existe précisément pour qu'une valeur ne vive plus dans trois documents qui se
#    contredisent — donne `CACHE_STORE: redis` et `SESSION_DRIVER: redis` pour la préproduction
#    ET pour la production, `etat: mesure`, date 2026-08-16. Ce commentaire citait
#    `deploy-preview.html`, c'est-à-dire l'une des trois copies que ce relevé a REMPLACÉES.
# 2. `.env.example` déclare `redis`. Ce fichier divergeait donc de son propre pendant, dans le
#    sens qui s'annonçait comme un alignement.
# 3. Et surtout, `database` NE MARCHE PAS ici. Mesuré le 2026-08-22, par exécution :
#
#      $ CACHE_STORE=database php artisan tinker --execute="Cache::tags(['x'])->put('a',1,60);"
#      BadMethodCallException — This cache store does not support tagging.
#
#    `app/Services/Property/SimilarPropertiesService.php:19,157` emploie `Cache::tags()`. Tout
#    développeur qui suivait ce fichier obtenait donc un 500 sur les biens similaires, sans que
#    rien ne le prévienne — le compose démarre bien un Redis, ce fichier lui tournait le dos.
#
# `QUEUE_CONNECTION` reste `database` : c'est ce que les deux environnements déployés déclarent.
# Le relevé se lit dans `docs/infra/prod-drivers.json`, et NULLE PART AILLEURS.
# ==========================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
# CACHE_PREFIX=

QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
# 6380 : cf. la note de DB_PORT ci-dessus.
REDIS_PORT=6380

# ==========================================
# Logging
# ==========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==========================================
# Search (Laravel Scout) — service `meilisearch` du compose
#
# `meilisearch` et non `collection`. Le driver `collection` filtre en PHP sur une
# collection Eloquent : il ne partage ni la tokenisation, ni le classement par
# pertinence, ni la tolérance aux fautes du moteur réel. Une recherche éprouvée en
# `collection` n'a rien prouvé de celle qui tourne en CI et en production.
#
# Après un `migrate:fresh --seed`, réindexer : `php artisan scout:import` par modèle,
# ou le seeder s'en charge (cf. commit « fix(seed): reindex searchable models »).
# ==========================================
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7701
MEILISEARCH_KEY=masterKey
# `false` en développement : avec la file, un document indexé n'apparaît dans la
# recherche que quand un worker est passé — un décalage qu'on prend pour un bug.
SCOUT_QUEUE=false
SCOUT_AFTER_COMMIT=true
# SCOUT_PREFIX=

# ==========================================
# Mail — service `mailpit` du compose · UI sur http://localhost:8026
#
# `smtp` et non `log`. Une vingtaine de tâches planifiées envoient du courrier
# (rappels de paiement, relances de facture, digests, invitations, onboarding) :
# en `log` elles partent dans un fichier que personne ne relit, et on ne voit
# jamais le rendu réel d'un e-mail avant qu'un utilisateur le reçoive.
# ==========================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1026
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@takussan.test"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# AWS / S3 (used by filesystem + media-library when FILESYSTEM_DISK=s3)
# ==========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==========================================
# Vite
# ==========================================
VITE_APP_NAME="${APP_NAME}"

# ==========================================
# OAuth — Google
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${FRONTEND_URL}/auth/oauth/google/callback"

# ==========================================
# OAuth — Facebook
# ==========================================
# Leave these blank in local/dev if no real Facebook app is configured; the
# frontend hides unconfigured providers.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${FRONTEND_URL}/auth/oauth/facebook/callback"

# ==========================================
# OAuth — Apple (TCK-081)
# ==========================================
# Leave these blank in local/dev if no real Apple Services ID is configured;
# the frontend hides unconfigured providers.
# Services ID declared in Apple Developer → Identifiers (e.g. com.takussan.web).
APPLE_CLIENT_ID=
# Apple Developer Team ID (10-char), visible top-right of developer portal.
APPLE_TEAM_ID=
# Key ID (10-char) of the .p8 generated in Apple Developer → Keys.
APPLE_KEY_ID=
# Absolute path to the AuthKey_XXXXXXXXXX.p8 file. Leave empty outside prod.
APPLE_PRIVATE_KEY_PATH=
APPLE_REDIRECT_URI="${FRONTEND_URL}/auth/oauth/apple/callback"

# ==========================================
# CDN (TCK-105)
# Set CDN_ENABLED=true once the CDN is provisioned.
# ==========================================
CDN_ENABLED=false
CDN_PROVIDER=bunny
CDN_BASE_URL=
CDN_PULL_ZONE=
CDN_SIGNING_KEY=
CDN_SIGNATURE_TTL=300

BUNNY_ACCESS_KEY=
BUNNY_STORAGE_ZONE=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ==========================================
# Spatie Laravel PDF
# Driver: cloudflare | browsershot | gotenberg | dompdf
#
# `dompdf` en développement : c'est le seul driver qui ne dépend d'aucun service
# externe (Cloudflare Browser Rendering, un Chrome headless ou un Gotenberg). Un PDF
# rendu en local n'est pas au pixel celui de la production — l'écart est assumé et
# noté ici plutôt que découvert au premier document généré hors ligne.
# ==========================================
LARAVEL_PDF_DRIVER=dompdf

# ==========================================
# SMS — accusés de livraison entrants (TCK-102)
# Voir `.env.example` pour le détail : ni Orange ni Mtarget n'émettent de signature,
# la liste blanche d'IP est la seule protection disponible, et le middleware est
# fail-closed en production seulement. Ici `APP_ENV=local` : listes vides = laissez-passer.
# ==========================================
SMS_DEFAULT_DRIVER=log
SMS_RATE_LIMIT_PER_USER_HOUR=10
SMS_QUIET_HOURS_ENABLED=true
SMS_WEBHOOK_URL_TOKEN=
SMS_ORANGE_WEBHOOK_IPS=
SMS_MTARGET_WEBHOOK_IPS=
SMS_LAM_WEBHOOK_IPS=
SMS_ORANGE_OAUTH_URL=
SMS_ORANGE_SEND_URL=
SMS_MTARGET_SEND_URL=
SMS_LAM_SEND_URL=

# ==========================================
# WhatsApp — gardes du webhook entrant (TCK-296)
# ==========================================
# Lues par `config/whatsapp.php` avec un défaut vide, et fail-closed toutes les trois :
# jeton vide → 404, secret vide → rejet de signature, allowlist vide → 403. Elles
# n'étaient déclarées ni ici ni dans `.env.example`, donc invisibles à la garde de
# parité — deux fichiers auxquels il manque la même clé sont en parité parfaite.
# Vides en développement : le webhook WhatsApp n'est pas exercé localement.
WHATSAPP_WEBHOOK_URL_TOKEN=
WHATSAPP_WEBHOOK_APP_SECRET=
WHATSAPP_WEBHOOK_IPS=
# TCK-294 — Pulling des accusés de livraison Mtarget (voir `.env.example` pour le
# raisonnement). Inerte ici : driver `log`, pulling désactivé.
SMS_DLR_PULL_DRIVER=log
SMS_DLR_PULL_ENABLED=false
SMS_DLR_PULL_MAX=50
SMS_DLR_PULL_MAX_BATCHES=20
SMS_MTARGET_PULL_URL=
SMS_MTARGET_WEBHOOK_ENABLED=true
