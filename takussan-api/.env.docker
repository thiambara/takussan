# ==========================================
# Environnement de développement SUR DOCKER — `docker-compose.yml` à la racine.
#
#   ./dev.sh          copie ce fichier vers `.env` s'il n'existe pas, puis démarre tout.
#   cp .env.docker .env && php artisan key:generate    (à la main, si on préfère)
#
# Ce fichier existe parce que `.env.example` décrit un environnement qui n'est celui
# de PERSONNE : il pose `DB_CONNECTION=sqlite` quand la production tourne sur MariaDB,
# `SCOUT_DRIVER=collection` quand la CI et la production indexent sur Meilisearch, et
# `CACHE_STORE=redis` sans que rien ne fournisse Redis — un développeur qui copie
# l'exemple obtient une application qui ne démarre pas.
#
# Ici, chaque driver est celui de la PRODUCTION, servi par un conteneur local. Ce
# n'est pas du confort : c'est la seule façon qu'une migration, une recherche ou une
# requête soit éprouvée avant le déploiement plutôt qu'après.
#
# ⚠️ `.env.example` reste le contrat des CLÉS. Les deux fichiers doivent déclarer
# exactement le même jeu de clés — `node scripts/check-env-parity.mjs` le vérifie, et
# la CI le rejoue. Une clé ajoutée d'un côté et pas de l'autre est un piège qui ne se
# révèle qu'au moment où quelqu'un reprend le projet.
# ==========================================

# ==========================================
# App
# ==========================================
APP_NAME=Takussan
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# `127.0.0.1` et non `localhost`, pour s'accorder avec ce que le reste du dispositif fait
# RÉELLEMENT : `dev.sh` lance `artisan serve --host=127.0.0.1`, et `takussan-web` pointe sur
# `http://127.0.0.1:8002`. Du point de vue du navigateur, `localhost` et `127.0.0.1` sont deux
# ORIGINES distinctes : tout ce qui repose sur un cookie same-origin, ou sur `APP_URL` pour
# construire une redirection de retour vers l'API, tombe sur la mauvaise. C'est sans effet tant
# que l'authentification passe par un Bearer via le BFF — mais `.env.docker` est le socle
# reproductible du projet, et il ne doit pas graver un désaccord dans son défaut.
APP_URL=http://127.0.0.1:8002

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4
# 4 et non 12 : le hachage n'est pas ce qu'on éprouve en développement, et 12 rounds
# rendent chaque login de test ~250 ms. La production garde le défaut du framework.
BCRYPT_ROUNDS=4

# ==========================================
# Frontend & Sanctum
# ==========================================
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Comma-separated list of upstream proxy IPs/CIDRs that may set
# X-Forwarded-For (Next.js server-actions, load balancer, reverse proxy).
# Required so per-visitor rate limiters and `Request::ip()` see the real
# client IP instead of a single shared proxy address. In production, pin
# this to the actual proxy network — `*` allows IP spoofing.
TRUSTED_PROXIES=127.0.0.1,::1

# ==========================================
# Database — service `mariadb` du compose
#
# 3307 et non 3306 : le port canonique est occupé par une installation native de
# MySQL sur la machine de développement. Si tu changes `TAKUSSAN_DB_PORT` dans le
# `.env` de la racine, change DB_PORT ici — `./dev.sh` le vérifie et refuse de
# démarrer sur un désaccord plutôt que de te laisser déboguer une connexion morte.
# ==========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=takussan
DB_USERNAME=takussan
DB_PASSWORD=takussan

# Le seeder télécharge de vraies photos de biens (plusieurs dizaines de Mo).
# `false` pour un `migrate:fresh --seed` rapide et hors ligne.
SEED_DOWNLOAD_MEDIA=true

# Les volumes du seeder — lus par `SeedingConfig::fromEnv()`, qui porte les
# valeurs par défaut. Décommenter pour alléger un `migrate:fresh --seed` :
# `SEED_AGENCIES=1` + `SEED_PROPERTIES_PER_AGENCY=20` suffit pour naviguer
# l'interface sans attendre les ~450 biens du jeu complet.
# SEED_AGENCIES=
# SEED_PROPERTIES_PER_AGENCY=
# SEED_CUSTOMERS_PER_AGENCY=
# SEED_BOOKINGS_PER_AGENCY=
# SEED_LEASES_PER_AGENCY=
# SEED_MAINTENANCE_PER_AGENCY=
# SEED_CONVERSATIONS_PER_AGENCY=
# SEED_DOCUMENTS_PER_AGENCY=
# SEED_EDGE_CASES=
# SEED_REFERENTIAL_INTEGRITY=
# SEED_FILTER_COVERAGE=
# SEED_DEMO_USERS=

# ==========================================
# Session / Cache / Queue
#
# `database` partout, comme la PRODUCTION (cf. docs/infra/deploy-preview.html) —
# et non `redis`, que `.env.example` propose sans que la production l'utilise.
# Redis est démarré par le compose quand même : il est là pour qu'on puisse
# MESURER la bascule le jour où on la décide, pas pour qu'on diverge en silence.
# ==========================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# CACHE_PREFIX=

QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
# 6380 : cf. la note de DB_PORT ci-dessus.
REDIS_PORT=6380

# ==========================================
# Logging
# ==========================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==========================================
# Search (Laravel Scout) — service `meilisearch` du compose
#
# `meilisearch` et non `collection`. Le driver `collection` filtre en PHP sur une
# collection Eloquent : il ne partage ni la tokenisation, ni le classement par
# pertinence, ni la tolérance aux fautes du moteur réel. Une recherche éprouvée en
# `collection` n'a rien prouvé de celle qui tourne en CI et en production.
#
# Après un `migrate:fresh --seed`, réindexer : `php artisan scout:import` par modèle,
# ou le seeder s'en charge (cf. commit « fix(seed): reindex searchable models »).
# ==========================================
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7701
MEILISEARCH_KEY=masterKey
# `false` en développement : avec la file, un document indexé n'apparaît dans la
# recherche que quand un worker est passé — un décalage qu'on prend pour un bug.
SCOUT_QUEUE=false
SCOUT_AFTER_COMMIT=true
# SCOUT_PREFIX=

# ==========================================
# Mail — service `mailpit` du compose · UI sur http://localhost:8026
#
# `smtp` et non `log`. Une vingtaine de tâches planifiées envoient du courrier
# (rappels de paiement, relances de facture, digests, invitations, onboarding) :
# en `log` elles partent dans un fichier que personne ne relit, et on ne voit
# jamais le rendu réel d'un e-mail avant qu'un utilisateur le reçoive.
# ==========================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1026
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@takussan.test"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# AWS / S3 (used by filesystem + media-library when FILESYSTEM_DISK=s3)
# ==========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==========================================
# Vite
# ==========================================
VITE_APP_NAME="${APP_NAME}"

# ==========================================
# OAuth — Google
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${FRONTEND_URL}/auth/oauth/google/callback"

# ==========================================
# OAuth — Facebook
# ==========================================
# Leave these blank in local/dev if no real Facebook app is configured; the
# frontend hides unconfigured providers.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${FRONTEND_URL}/auth/oauth/facebook/callback"

# ==========================================
# OAuth — Apple (TCK-081)
# ==========================================
# Leave these blank in local/dev if no real Apple Services ID is configured;
# the frontend hides unconfigured providers.
# Services ID declared in Apple Developer → Identifiers (e.g. com.takussan.web).
APPLE_CLIENT_ID=
# Apple Developer Team ID (10-char), visible top-right of developer portal.
APPLE_TEAM_ID=
# Key ID (10-char) of the .p8 generated in Apple Developer → Keys.
APPLE_KEY_ID=
# Absolute path to the AuthKey_XXXXXXXXXX.p8 file. Leave empty outside prod.
APPLE_PRIVATE_KEY_PATH=
APPLE_REDIRECT_URI="${FRONTEND_URL}/auth/oauth/apple/callback"

# ==========================================
# CDN (TCK-105)
# Set CDN_ENABLED=true once the CDN is provisioned.
# ==========================================
CDN_ENABLED=false
CDN_PROVIDER=bunny
CDN_BASE_URL=
CDN_PULL_ZONE=
CDN_SIGNING_KEY=
CDN_SIGNATURE_TTL=300

BUNNY_ACCESS_KEY=
BUNNY_STORAGE_ZONE=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ==========================================
# Spatie Laravel PDF
# Driver: cloudflare | browsershot | gotenberg | dompdf
#
# `dompdf` en développement : c'est le seul driver qui ne dépend d'aucun service
# externe (Cloudflare Browser Rendering, un Chrome headless ou un Gotenberg). Un PDF
# rendu en local n'est pas au pixel celui de la production — l'écart est assumé et
# noté ici plutôt que découvert au premier document généré hors ligne.
# ==========================================
LARAVEL_PDF_DRIVER=dompdf
