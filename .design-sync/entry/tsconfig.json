{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": false,
    "rootDir": "../..",
    "outDir": "types",
    "baseUrl": ".",
    "paths": { "@/*": ["../../takussan-web/src/*"] }
  },
  "files": ["index.ts"]
}
